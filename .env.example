[TEMPLATE]
# --- LLM provider ---------------------------------------------------------
# "offline" runs the deterministic, key-free engine used by the demo/tests.
# "openai" uses the OpenAI SDK for every agent (requires OPENAI_API_KEY).
LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Orchestration --------------------------------------------------------
# Per-agent hard timeout (seconds).
AGENT_TIMEOUT_SECONDS=120
# Number of times an agent node is retried on transient failure.
AGENT_MAX_RETRIES=2
# Maximum executor <-> validator correction loops.
MAX_ATTEMPTS=3
# Default for requests that do not specify auto_approve.
DEFAULT_AUTO_APPROVE=false
# Validator acceptance threshold (0..1).
VALIDATION_THRESHOLD=0.75

# --- Persistence (required for deployment) --------------------------------
# "sqlite" makes paused approvals and run history survive API restarts.
# "memory" is the single-process demo default.
CHECKPOINT_BACKEND=memory
CHECKPOINT_DB_PATH=data/checkpoints.db
RUN_STORE_BACKEND=memory
RUN_DB_PATH=data/runs.db

# --- API authentication ---------------------------------------------------
# Set true in deployment. With auth on and no keys configured, workflow
# endpoints fail closed (503) rather than allowing anonymous calls.
API_AUTH_ENABLED=false
# Comma-separated key:identity pairs. Generate a key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The identity is recorded as submitter/reviewer; client-supplied reviewer
# names are overridden by it.
API_KEYS=

# --- Server / UI ----------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOG_LEVEL=INFO
CRM_DB_PATH=data/crm.db
